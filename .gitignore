!/historia_demo.js
!/gesty.js
!/gesty_i18n.js
!/gesty.css
!/gesty_ui.js
!/rozklad_core.js
!/rozklad.js
!/rozklad.css
!/dzwieki.js
!/p1_filters.js
historia_pakiet*
deploy_response*
*.orig
*.pdf
*.zip
